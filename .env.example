NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-local-or-hosted-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default 3 MB fits Vercel's request limit. Other hosts may allow up to 10 MB.
MAX_IMAGE_SIZE_MB=3

# Standings: server-side only. Blank credentials use VolleyballLive's public JSON service.
VOLLEYBALL_SEASON_ID=201070
VOLLEYBALL_TOURNAMENT_ID=449623
NIF_CLIENT_ID=
NIF_CLIENT_SECRET=
NIF_SCOPE=data_ta_read

# Daily match import (server-only). Apply the match-sync migration first.
VOLLEYBALL_TEAM_ID=913845
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Set to 0 to disable import. The local fictional demo defaults to 0.
VOLLEYBALL_MATCH_SYNC_ENABLED=1

# Public browser key for meme reactions. Create an API key at developers.giphy.com/dashboard/.
NEXT_PUBLIC_GIPHY_API_KEY=

# Activity emails (separate from Supabase Auth SMTP). Server-only.
# Set to resend in production; npm run dev forces safe local previews.
NOTIFICATION_EMAIL_MODE=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
